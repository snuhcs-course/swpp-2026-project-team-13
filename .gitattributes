* text=auto
*.sh text eol=lf
*.py text eol=lf
*.swift text eol=lf

# Preserve exact bytes of hash-pinned score, sheet and audio resources.
*.mxl binary
backend/content/source/naver/*.musicxml binary
backend/content/source/classical/*.xml binary
backend/content/source/brahms/*.musicxml binary
backend/content/source/mahler/*.musicxml binary
backend/content/source/practice-import/*.xml binary
backend/content/source/practice-import/*.musicxml binary
*.jpg binary
*.png binary
*.pngdata binary
*.sf2 binary
*.wav binary

# The renderer manifest pins the stylesheet hash on Windows and Linux.
*.mss text eol=lf

# Keep the specification fixture's XML hash identical across platforms.
docs/feature-v1/example.musicxml text eol=lf
backend/solfege/features/fixtures/example.musicxml text eol=lf

# The app and API pin the same exact catalog bytes, including the final newline.
backend/content/rhythm-puzzle-v1.json text eol=lf
frontend/IPadApp/IPadApp/Resources/rhythm-puzzle-v1.json text eol=lf
docs/RHYTHM-PUZZLE-EXCEPTIONS.md text eol=lf
backend/content/rhythm-puzzle-v2.json text eol=lf
frontend/IPadApp/IPadApp/Resources/rhythm-puzzle-v2.json text eol=lf
frontend/IPadApp/IPadApp/Resources/rhythm-engraving-v2.json text eol=lf
docs/RHYTHM-PUZZLE-V2-EXCEPTIONS.md text eol=lf
backend/content/rhythm-puzzle-v3.json text eol=lf
frontend/IPadApp/IPadApp/Resources/rhythm-puzzle-v3.json text eol=lf
frontend/IPadApp/IPadApp/Resources/rhythm-engraving-v3.json text eol=lf
docs/RHYTHM-PUZZLE-V3-EXCEPTIONS.md text eol=lf

# Memory run fingerprints the original library XML and added excerpt sources.
frontend/IPadApp/IPadApp/Resources/melody--*.xml text eol=lf
frontend/IPadApp/IPadApp/Resources/memory--*.xml text eol=lf
frontend/IPadApp/IPadApp/Resources/memory-run-v2.json text eol=lf
docs/memory-import-report.json text eol=lf
