# Copy to .env. Keep .env private; never put OpenRouter keys in the iPad app.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=sori
POSTGRES_USER=sori
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
OPENROUTER_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=240
AI_MAX_OUTPUT_TOKENS=16000
AI_MAX_JOBS_PER_ATTEMPT=3
