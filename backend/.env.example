# Copy to .env. Keep .env private; never put OpenRouter keys in the iPad app.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=sori
POSTGRES_USER=sori
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6.1-sol
OPENROUTER_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=240
AI_MAX_OUTPUT_TOKENS=16000
AI_MAX_JOBS_PER_ATTEMPT=3

# Signup and attempt limits (counts must be integers of at least 1; blank means unset).
# Signup on/off. Keep false unless a signup test is running.
SIGNUP_ENABLED=false
# Login requests per IP in the last 5 minutes.
LOGIN_MAX_REQUESTS_PER_IP=30
# Signup requests per IP in the last 5 minutes.
SIGNUP_MAX_REQUESTS_PER_IP=30
# Successful signups per IP in the last 24 hours.
SIGNUP_MAX_SUCCESSES_PER_IP=20
# Required when SIGNUP_ENABLED=true; there is no default. Choose so that
# AI_MAX_JOBS_PER_DAY x (maximum cost of one job) <= daily budget, and keep the OpenRouter key's
# spending limit at or below the same budget. One job's maximum cost is its input image and prompt
# tokens plus AI_MAX_OUTPUT_TOKENS, multiplied by the model's prices.
# Grading jobs per user in the last 24 hours.
AI_MAX_JOBS_PER_USER_PER_DAY=
# Grading jobs across the server in the last 24 hours.
AI_MAX_JOBS_PER_DAY=
# Comma-separated CIDR list of trusted proxies, e.g. the cloudflared container's address/32.
TRUSTED_PROXIES=
# Header in which a trusted proxy sends the one client IP, e.g. CF-Connecting-IP.
# Set together with TRUSTED_PROXIES.
CLIENT_IP_HEADER=
# Port the api server listens on.
PORT=8000
